# 이 파일을 복사해서 .env 로 만들어 쓰세요.
#   cp .env.example .env
# .env 는 깃허브에 올라가지 않습니다.
#
# 값을 바꾼 뒤에는 반드시 캐시를 지우고 다시 시작해야 반영됩니다.
#   npx expo start -c

# 서버 주소 (Lightsail FastAPI). 끝에 / 를 붙이지 마세요.
EXPO_PUBLIC_API_URL=https://your-server-address

# 서버 인증 토큰. 서버의 X-App-Token 값과 같아야 합니다.
EXPO_PUBLIC_API_TOKEN=

# ====================================================================
# 서버 없이 가짜 데이터로 개발할 때 true.
# 서버를 연결한 뒤에는 반드시 false 로 바꾸세요.
# 이걸 안 바꾸면 계속 같은 결과만 나옵니다. (매우 흔한 실수)
# ====================================================================
EXPO_PUBLIC_USE_MOCK=true
