# 이 파일을 복사해서 .env 로 만들어 쓰세요.
#   cp .env.example .env
# .env 는 깃허브에 올라가지 않습니다.
#
# 값을 바꾼 뒤에는 반드시 캐시를 지우고 다시 시작해야 반영됩니다.
#   npx expo start -c
#
# 채워야 하는 건 아래 토큰 하나뿐입니다. 나머지는 안 건드려도 됩니다.


# ====================================================================
# 필수 — 이것만 채우면 됩니다
# ====================================================================
#
# 서버 /etc/albacheck.env 의 APP_TOKEN 과 같은 값입니다. 32자입니다.
# 값은 전정현에게 받으세요. 저장소에 적지 않습니다.
#
# 비워두면 앱이 X-App-Token 헤더를 아예 안 보내고 서버가 401 로 막습니다.
# 화면에는 "지금은 분석할 수 없어요" 로만 보여서 원인을 알 수 없습니다.
EXPO_PUBLIC_API_TOKEN=


# ====================================================================
# 아래는 선택 — 기본값으로 두면 됩니다
# ====================================================================

# 서버 없이 가짜 데이터로 화면만 만들 때 true 로 바꿉니다.
#
# ⚠ true 로 두면 어떤 계약서를 넣어도 결과가 똑같이 나옵니다.
#   (시급=위법소지, 수습감액=확인필요, 나머지 문제없음 / 분석이 2초에 끝남)
#   실제 판정은 6~7초 걸립니다. 2초에 끝나면 목 모드입니다.
#   화면 작업이 끝나면 반드시 false 로 돌려놓으세요.
EXPO_PUBLIC_USE_MOCK=false

# 목 모드에서 일부러 에러를 내고 싶을 때 씁니다. (에러 화면 만들 때 필요)
# 비워두면 항상 성공합니다.
#
#   timeout     분석이 오래 걸리고 있어요
#   network     인터넷 연결을 확인해 주세요
#   server      지금은 분석할 수 없어요
#   unreadable  계약서를 읽지 못했어요
#   notContract 근로계약서가 아닌 것 같아요
EXPO_PUBLIC_MOCK_ERROR=

# 서버 주소.
#
# 비워두면 배포된 서버(https://smpsws.shop/albacheck)를 씁니다.
# 기본값이 lib/api.ts 의 DEFAULT_API_URL 에 있으므로 여기 적을 필요가 없습니다.
#
# 로컬에서 띄운 서버에 붙일 때만 채웁니다. 그때는 끝에 / 를 붙이지 마세요.
#   EXPO_PUBLIC_API_URL=http://127.0.0.1:8003
EXPO_PUBLIC_API_URL=
