# server/.env 로 복사해서 값을 채웁니다. .env 는 깃허브에 올라가지 않습니다.

# ── OpenAI ──────────────────────────────────────────────
# 콘솔에서 발급: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# 사진을 읽어야 하므로 vision 을 지원하는 모델이어야 합니다.
#
# 계약서 4종(최저임금 미달 / 근로시간 초과 / 휴게시간 부족 / 정상)으로 실제 재본 결과:
#
#   gpt-5.4        4/4 통과   평균  7초 (최대 8초)   ← 권장
#   gpt-5.5        4/4 통과   평균 19초 (최대 26초)  정확하지만 느림
#   gpt-4o         2/4        평균  7초   휴게시간 위반을 놓침
#   gpt-5.4-mini   2/4        평균  5초   없는 위법을 만들어낸 적 있음. 쓰지 마세요
#
# 앱 타임아웃은 45초입니다. gpt-5.4 는 평균 7초라 업로드 시간을 더해도 여유가 큽니다.
#
# ⚠ 모델 이름은 수시로 바뀝니다. 콘솔에서 현재 쓸 수 있는 이름을 확인하세요.
#   이름이 틀리면 OpenAI 가 404 를 주고, 앱에는 "지금은 분석할 수 없어요" 로만 보입니다.
#   (서버 로그에는 이유가 그대로 찍힙니다)
OPENAI_MODEL=gpt-5.4

# ── 앱 인증 ─────────────────────────────────────────────
# 앱 .env 의 EXPO_PUBLIC_API_TOKEN 과 똑같은 값이어야 합니다.
#
# ⚠ 비워 두면 서버가 토큰 검사를 건너뜁니다. 로컬 테스트용이며 배포할 때는 반드시 채우세요.
#   앱은 토큰이 비어 있으면 X-App-Token 헤더를 아예 보내지 않습니다. 한쪽만 채우면 전부 401 입니다.
APP_TOKEN=

# ── 한계값 ──────────────────────────────────────────────
# 디코딩한 사진의 최대 크기(MB). 넘으면 413.
MAX_IMAGE_MB=8

# OpenAI 호출 타임아웃(초). 앱 타임아웃이 45초라 그보다 짧아야 합니다.
OPENAI_TIMEOUT=40

# 서버가 들을 포트
PORT=8000

LOG_LEVEL=INFO
